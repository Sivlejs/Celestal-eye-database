# PostgreSQL (used by Docker Compose local dev)
POSTGRES_USER=celestal
POSTGRES_PASSWORD=celestal_secret
POSTGRES_DB=celestal_eye

# Backend
PORT=3000
DATABASE_URL=postgresql://celestal:celestal_secret@postgres:5432/celestal_eye

# Auth — generate a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret

# CORS — comma-separated list of allowed origins for the Celestal Eye app.
# Leave blank to allow all origins (fine for local dev and mobile clients).
# Example: https://celestal-eye.app,https://www.celestal-eye.app
ALLOWED_ORIGINS=

# PayPal Integration
# Get your credentials from https://developer.paypal.com/dashboard/applications/sandbox
# For production, use live credentials from https://developer.paypal.com/dashboard/applications/live
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal Subscription Plan ID (required for subscriptions)
# Create a subscription plan at https://www.paypal.com/billing/plans
# Then copy the Plan ID here
PAYPAL_PLAN_ID=your_subscription_plan_id_here

